# ------------------------------------------------------------------
# Elmo POS Licensing Admin Dashboard — environment configuration
# ------------------------------------------------------------------
# Only NEXT_PUBLIC_* variables are bundled into the browser. Never put a
# secret / server key or a signing private key behind one. This file contains
# placeholders only; put real local values in untracked .env.local.
# ------------------------------------------------------------------

# Server-owned environment identity (see src/server/env.ts). NOT
# prefixed NEXT_PUBLIC_ — this is deliberately unreadable by the browser
# and is not a client-editable value. Defaults to "staging" when unset;
# setting "production" while NODE_ENV isn't "production" (e.g. under
# `next dev`) is a hard failure, as is a mismatch against the configured
# Supabase project ref below.
APP_ENV=staging

# --- Staging (elmotech-pos-licensing-staging, ref: sweezvyqlmerlcxjkair) ---
# Local development MUST use these values.
NEXT_PUBLIC_SUPABASE_URL=https://sweezvyqlmerlcxjkair.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<staging-publishable-key>
SUPABASE_SECRET_KEY=<staging-server-secret-key>

# --- Production (elmotech-pos-licensing-prod, ref: lhfvlczfqltvwydfaeod) ---
# Do not use these locally, and do not set APP_ENV=production locally —
# it is refused outside of NODE_ENV=production. Only set both in the
# production deployment's own, separately managed environment
# configuration.
# APP_ENV=production
# NEXT_PUBLIC_SUPABASE_URL=https://lhfvlczfqltvwydfaeod.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<production-publishable-key>
# SUPABASE_SECRET_KEY=<production-server-secret-key>
