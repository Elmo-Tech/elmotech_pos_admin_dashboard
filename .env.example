# Server-owned environment. Use staging for local development.
# APP_ENV=production requires NODE_ENV=production.
APP_ENV=staging

# Laravel is the default, including when DATA_PROVIDER is unset.
# Keep this URL server-side. HTTPS is required outside localhost.
DATA_PROVIDER=laravel
LARAVEL_API_URL=http://127.0.0.1:8000/api/v1

# DEPRECATED: explicit legacy Supabase mode only.
# Do not configure Supabase for new Laravel installations.
# DATA_PROVIDER=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://sweezvyqlmerlcxjkair.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<staging-publishable-key>
# SUPABASE_SECRET_KEY=<staging-server-secret-key>
# Never put database secrets or signing private keys in NEXT_PUBLIC_* variables.
