{
  "server/app-paths-manifest.json": {
    "/_not-found/page": "app/_not-found/page.js",
    "/_global-error/page": "app/_global-error/page.js",
    "/api/locale/route": "app/api/locale/route.js",
    "/favicon.ico/route": "app/favicon.ico/route.js",
    "/api/activation/verify/route": "app/api/activation/verify/route.js",
    "/api/activation/issue/route": "app/api/activation/issue/route.js",
    "/api/renewal/issue/route": "app/api/renewal/issue/route.js",
    "/login/page": "app/login/page.js",
    "/page": "app/page.js",
    "/(dashboard)/activation-requests/page": "app/(dashboard)/activation-requests/page.js",
    "/(dashboard)/audit-logs/page": "app/(dashboard)/audit-logs/page.js",
    "/(dashboard)/customers/[customerId]/page": "app/(dashboard)/customers/[customerId]/page.js",
    "/(dashboard)/customers/page": "app/(dashboard)/customers/page.js",
    "/(dashboard)/dashboard/page": "app/(dashboard)/dashboard/page.js",
    "/(dashboard)/devices/page": "app/(dashboard)/devices/page.js",
    "/(dashboard)/issuances/page": "app/(dashboard)/issuances/page.js",
    "/(dashboard)/licenses/[licenseId]/page": "app/(dashboard)/licenses/[licenseId]/page.js",
    "/(dashboard)/licenses/page": "app/(dashboard)/licenses/page.js",
    "/(dashboard)/plans/page": "app/(dashboard)/plans/page.js",
    "/(dashboard)/settings/page": "app/(dashboard)/settings/page.js",
    "/(dashboard)/subscriptions/page": "app/(dashboard)/subscriptions/page.js"
  },
  "server/pages-manifest.json": {
    "/500": "pages/500.html"
  },
  "routes-manifest.json": {
    "version": 3,
    "pages404": true,
    "appType": "app",
    "caseSensitive": false,
    "basePath": "",
    "redirects": [
      {
        "source": "/:path+/",
        "destination": "/:path+",
        "internal": true,
        "priority": true,
        "statusCode": 308,
        "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
      }
    ],
    "headers": [],
    "onMatchHeaders": [],
    "rewrites": {
      "beforeFiles": [],
      "afterFiles": [],
      "fallback": []
    },
    "dynamicRoutes": [
      {
        "page": "/customers/[customerId]",
        "regex": "^/customers/([^/]+?)(?:/)?$",
        "routeKeys": {
          "nxtPcustomerId": "nxtPcustomerId"
        },
        "namedRegex": "^/customers/(?<nxtPcustomerId>[^/]+?)(?:/)?$"
      },
      {
        "page": "/licenses/[licenseId]",
        "regex": "^/licenses/([^/]+?)(?:/)?$",
        "routeKeys": {
          "nxtPlicenseId": "nxtPlicenseId"
        },
        "namedRegex": "^/licenses/(?<nxtPlicenseId>[^/]+?)(?:/)?$"
      }
    ],
    "staticRoutes": [
      {
        "page": "/",
        "regex": "^/(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/(?:/)?$"
      },
      {
        "page": "/_global-error",
        "regex": "^/_global\\-error(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/_global\\-error(?:/)?$"
      },
      {
        "page": "/_not-found",
        "regex": "^/_not\\-found(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/_not\\-found(?:/)?$"
      },
      {
        "page": "/activation-requests",
        "regex": "^/activation\\-requests(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/activation\\-requests(?:/)?$"
      },
      {
        "page": "/api/activation/issue",
        "regex": "^/api/activation/issue(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/api/activation/issue(?:/)?$"
      },
      {
        "page": "/api/activation/verify",
        "regex": "^/api/activation/verify(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/api/activation/verify(?:/)?$"
      },
      {
        "page": "/api/locale",
        "regex": "^/api/locale(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/api/locale(?:/)?$"
      },
      {
        "page": "/api/renewal/issue",
        "regex": "^/api/renewal/issue(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/api/renewal/issue(?:/)?$"
      },
      {
        "page": "/audit-logs",
        "regex": "^/audit\\-logs(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/audit\\-logs(?:/)?$"
      },
      {
        "page": "/customers",
        "regex": "^/customers(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/customers(?:/)?$"
      },
      {
        "page": "/dashboard",
        "regex": "^/dashboard(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/dashboard(?:/)?$"
      },
      {
        "page": "/devices",
        "regex": "^/devices(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/devices(?:/)?$"
      },
      {
        "page": "/favicon.ico",
        "regex": "^/favicon\\.ico(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/favicon\\.ico(?:/)?$"
      },
      {
        "page": "/issuances",
        "regex": "^/issuances(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/issuances(?:/)?$"
      },
      {
        "page": "/licenses",
        "regex": "^/licenses(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/licenses(?:/)?$"
      },
      {
        "page": "/login",
        "regex": "^/login(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/login(?:/)?$"
      },
      {
        "page": "/plans",
        "regex": "^/plans(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/plans(?:/)?$"
      },
      {
        "page": "/settings",
        "regex": "^/settings(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/settings(?:/)?$"
      },
      {
        "page": "/subscriptions",
        "regex": "^/subscriptions(?:/)?$",
        "routeKeys": {},
        "namedRegex": "^/subscriptions(?:/)?$"
      }
    ],
    "dataRoutes": [],
    "rsc": {
      "header": "rsc",
      "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
      "prefetchHeader": "next-router-prefetch",
      "didPostponeHeader": "x-nextjs-postponed",
      "contentTypeHeader": "text/x-component",
      "suffix": ".rsc",
      "prefetchSegmentHeader": "next-router-segment-prefetch",
      "prefetchSegmentSuffix": ".segment.rsc",
      "prefetchSegmentDirSuffix": ".segments",
      "clientParamParsing": false,
      "dynamicRSCPrerender": false
    },
    "rewriteHeaders": {
      "pathHeader": "x-nextjs-rewritten-path",
      "queryHeader": "x-nextjs-rewritten-query"
    }
  }
}
